{
  "name": "bayer.ooo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:data": "node scripts/build-cms-data.js && node scripts/build-blog-data.js && node scripts/build-agent-content.js",
    "predev": "npm run build:data",
    "dev": "next dev -p 3001",
    "prebuild": "npm run build:data",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint src",
    "pretest": "npm run build:data",
    "test": "vitest",
    "pretest:run": "npm run build:data",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource/stack-sans-notch": "^5.3.0",
    "@fontsource/stack-sans-text": "^5.3.0",
